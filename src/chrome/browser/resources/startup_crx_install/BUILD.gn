build_webui("build") {
  grd_prefix = "startup_crx_install"

  static_files = [ 
    "startup_crx_install.html", 
    "startup_crx_install.css", 
    "startup_crx_install.js", 
    "Wootzapp.png",
    "ic_launcher_artifact.png",
    "ic_launcher_eclipse.png",
    "ic_launcher_blockmesh.png",
    "ic_launcher_camp.png", 
    "ic_launcher_sapien.png",
