static_library("wootz_offline_pages") {
  sources = [
    "wootz_mhtml_to_html_converter.cc",
    "wootz_mhtml_to_html_converter.h",
    "wootz_offline_page_prefs.cc",
    "wootz_offline_page_prefs.h",
    "wootz_offline_page_saver.cc",
    "wootz_offline_page_saver.h",
    "wootz_offline_page_saver_installer.cc",
    "wootz_offline_page_saver_installer.h",
    "wootz_offline_page_service.cc",
    "wootz_offline_page_service.h",
    "wootz_offline_page_service_factory.cc",
    "wootz_offline_page_service_factory.h",
    "wootz_offline_page_throttle.cc",
    "wootz_offline_page_throttle.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/profiles",
    "//chrome/common",
    "//components/keyed_service/content",
    "//components/prefs",
    "//content/public/browser",
    "//content/public/common",
    "//net",
    "//services/network/public/mojom",
    "//url",
  ]

  # Android-specific dependencies for JNI support
  if (is_android) {
    deps += [ "//chrome/android:chrome_jni_headers" ]
  }
}
