import("//build/config/features.gni")

# Activity Tracking Service for enterprise browser deployments
# Tracks user navigation and tab activities for analytics and monitoring
# Uses OpenTelemetry Protocol (OTLP) for vendor-neutral telemetry export
#
# Note: Manual OTLP implementation (no SDK) due to Chromium build compatibility

source_set("activity_tracking") {
  sources = [
    "activity_data_store.cc",
    "activity_data_store.h",
    "activity_tracking_service.cc",
    "activity_tracking_service.h",
    "activity_tracking_service_factory.cc",
    "activity_tracking_service_factory.h",
    "navigation_event_collector.cc",
    "navigation_event_collector.h",
    "otel_exporter.cc",
    "otel_exporter.h",
    "privacy_filter.cc",
    "privacy_filter.h",
    "security_policy_checker.cc",
    "security_policy_checker.h",
    "tab_event_collector.cc",
    "tab_event_collector.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//chrome/common",
    "//components/keyed_service/core",
    "//components/tab_groups",
    "//content/public/browser",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//ui/base",
    "//url",
  ]
  
  # OpenTelemetry SDK integration (currently disabled)
  # Enable with: use_otel_sdk = true
  # Note: Requires fixing SDK build compatibility with Chromium
  use_otel_sdk = false
  
  if (use_otel_sdk) {
    defines = [ "USE_OTEL_SDK" ]
    deps += [ "//third_party/opentelemetry:opentelemetry" ]
  }
}

