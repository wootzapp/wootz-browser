<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    
    <aapt:attr name="android:drawable">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4A90E2"
                android:centerColor="#7B68EE"
                android:endColor="#9370DB"
                android:angle="135"
                android:type="linear" />
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp" />
        </shape>
    </aapt:attr>
    
    <target android:name="gradient">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="startColor"
                    android:duration="3000"
                    android:valueFrom="#4A90E2"
                    android:valueTo="#FF6B6B"
                    android:valueType="colorType" />
                <objectAnimator
                    android:propertyName="centerColor"
                    android:duration="3000"
                    android:valueFrom="#7B68EE"
                    android:valueTo="#4ECDC4"
                    android:valueType="colorType" />
                <objectAnimator
                    android:propertyName="endColor"
                    android:duration="3000"
                    android:valueFrom="#9370DB"
                    android:valueTo="#45B7D1"
                    android:valueType="colorType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector> 