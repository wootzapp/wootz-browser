module automation.mojom;

import "mojo/public/mojom/base/string16.mojom";

interface AutomationAgent {
  // Gets the current state of the page
  GetPageState(bool debug_mode, bool include_hidden) => (bool success, string state);

  // Performs an action on the page
  PerformAction(string action, map<string, string> action_params) => (bool success);
};
