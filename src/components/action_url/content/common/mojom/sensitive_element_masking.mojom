module sensitive_masking.mojom;

// Interface for sending masking commands from browser to renderer
interface SensitiveElementMaskingDriver {
  // Updates the list of selectors that should be masked (no callback - simplified)
  UpdateMaskingSelectors(array<string> selectors);
  
  // Enables or disables masking
  SetMaskingEnabled(bool enabled);
}; 