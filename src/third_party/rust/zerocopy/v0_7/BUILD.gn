import("//build/rust/cargo_crate.gni")

cargo_crate("lib") {
  crate_name = "zerocopy"
  epoch = "0.7"
  crate_type = "rlib"
  crate_root = "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/src/lib.rs"

  # Unit tests skipped. Enable when needed for testing.
  build_native_rust_unit_tests = false

  # Source files that exist in the crate
  sources = [
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/src/byteorder.rs",
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/src/lib.rs",
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/src/macro_util.rs",
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/src/macros.rs",
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/src/post_monomorphization_compile_fail_tests.rs",
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/src/third_party/rust/layout.rs",
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/src/util.rs",
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/src/wrappers.rs",
  ]

  # Input files used by this crate
  inputs = [
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/README.md",
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/LICENSE-APACHE",
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/LICENSE-BSD",
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/LICENSE-MIT",
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/src/third_party/rust/LICENSE-APACHE",
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/src/third_party/rust/LICENSE-MIT",
    "//third_party/rust/chromium_crates_io/vendor/zerocopy-0.7.35/src/third_party/rust/README.fuchsia",
  ]

  # Dependencies from zerocopy's Cargo.toml
  deps = [
    "//third_party/rust/byteorder/v1:lib",
  ]

  # Optional features that are enabled
  features = [
    "default",
    "byteorder",
  ]

  edition = "2021"
  cargo_pkg_version = "0.7.35"
  cargo_pkg_authors = "Joshua Liebow-Feeser <hello@joshlf.com>, Ammon Spofford <aspofford@google.com>, Ian Swett <ianswett@google.com>"
  cargo_pkg_name = "zerocopy"
  cargo_pkg_description = "Utilities for zero-copy parsing and serialization"
  
  library_configs -= [ "//build/config/compiler:chromium_code" ]
  library_configs += [ "//build/config/compiler:no_chromium_code" ]
  executable_configs -= [ "//build/config/compiler:chromium_code" ]
  executable_configs += [ "//build/config/compiler:no_chromium_code" ]
  proc_macro_configs -= [ "//build/config/compiler:chromium_code" ]
  proc_macro_configs += [ "//build/config/compiler:no_chromium_code" ]

  # Only for usage from third-party crates
  visibility = [ "//third_party/rust/*" ]
}
